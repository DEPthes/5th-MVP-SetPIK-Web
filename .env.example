# 배포 환경의 백엔드 주소입니다. 끝에 /api/v1은 붙이지 않습니다.
VITE_API_BASE_URL=https://api.example.com

# 백엔드와 Spotify Dashboard에 등록한 콜백 주소와 정확히 같아야 합니다.
# 값을 비워두면 위 백엔드 주소 뒤에 /api/v1/auth/spotify/callback을 붙여 사용합니다.
VITE_SPOTIFY_REDIRECT_URI=https://api.example.com/api/v1/auth/spotify/callback

# 로컬 백엔드를 실행할 때 Vite가 /api 요청을 전달할 주소입니다.
# 실제 개인 설정은 이 파일이 아니라 .env.local에 작성합니다.
VITE_DEV_API_TARGET=http://127.0.0.1:8080
